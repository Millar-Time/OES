{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "8276299315337490682"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "eastus2",
      "metadata": {
        "description": "Deployment location. Locked to East US 2 for the demo."
      }
    },
    "prefix": {
      "type": "string",
      "defaultValue": "oes-demo",
      "metadata": {
        "description": "Short project prefix used in resource names."
      }
    },
    "openAiModel": {
      "type": "string",
      "defaultValue": "gpt-4o",
      "metadata": {
        "description": "Azure OpenAI model + deployment name to provision."
      }
    },
    "openAiModelVersion": {
      "type": "string",
      "defaultValue": "2024-08-06"
    },
    "tags": {
      "type": "object",
      "defaultValue": {
        "project": "OES",
        "env": "demo"
      },
      "metadata": {
        "description": "Resource tags."
      }
    }
  },
  "variables": {
    "suffix": "[uniqueString(resourceGroup().id)]",
    "names": {
      "logAnalytics": "[format('log-{0}-{1}', parameters('prefix'), variables('suffix'))]",
      "appInsights": "[format('appi-{0}-{1}', parameters('prefix'), variables('suffix'))]",
      "plan": "[format('plan-{0}-{1}', parameters('prefix'), variables('suffix'))]",
      "app": "[format('app-{0}-{1}', parameters('prefix'), variables('suffix'))]",
      "openai": "[format('aoai-{0}-{1}', parameters('prefix'), variables('suffix'))]",
      "cosmos": "[format('cosmos-{0}-{1}', parameters('prefix'), variables('suffix'))]",
      "maps": "[format('maps-{0}-{1}', parameters('prefix'), variables('suffix'))]"
    },
    "roles": {
      "openAiUser": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '5e0bd9bd-7b93-4f28-af87-19fc36ad61bd')]",
      "mapsDataReader": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '423170ca-a8f6-4b0f-8487-9e4eb8f49bfa')]",
      "metricsPublisher": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces",
      "apiVersion": "2023-09-01",
      "name": "[variables('names').logAnalytics]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "properties": {
        "sku": {
          "name": "PerGB2018"
        },
        "retentionInDays": 30
      }
    },
    {
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[variables('names').appInsights]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web",
        "WorkspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', variables('names').logAnalytics)]",
        "DisableLocalAuth": true
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', variables('names').logAnalytics)]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2024-04-01",
      "name": "[variables('names').plan]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "B1",
        "tier": "Basic"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2024-04-01",
      "name": "[variables('names').app]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "app,linux",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('names').plan)]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "PYTHON|3.11",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "OES_ENVIRONMENT",
              "value": "azure"
            },
            {
              "name": "OES_AZURE_OPENAI_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai), '2024-10-01').endpoint]"
            },
            {
              "name": "OES_AZURE_OPENAI_DEPLOYMENT",
              "value": "[parameters('openAiModel')]"
            },
            {
              "name": "OES_COSMOS_ENDPOINT",
              "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos), '2024-11-15').documentEndpoint]"
            },
            {
              "name": "OES_COSMOS_DATABASE",
              "value": "oes"
            },
            {
              "name": "OES_AZURE_MAPS_CLIENT_ID",
              "value": "[reference(resourceId('Microsoft.Maps/accounts', variables('names').maps), '2023-06-01').uniqueId]"
            },
            {
              "name": "APPLICATIONINSIGHTS_CONNECTION_STRING",
              "value": "[reference(resourceId('Microsoft.Insights/components', variables('names').appInsights), '2020-02-02').ConnectionString]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', variables('names').appInsights)]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos)]",
        "[resourceId('Microsoft.Maps/accounts', variables('names').maps)]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai)]",
        "[resourceId('Microsoft.Web/serverfarms', variables('names').plan)]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2024-10-01",
      "name": "[variables('names').openai]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "OpenAI",
      "sku": {
        "name": "S0"
      },
      "properties": {
        "customSubDomainName": "[variables('names').openai]",
        "publicNetworkAccess": "Enabled",
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2024-10-01",
      "name": "[format('{0}/{1}', variables('names').openai, parameters('openAiModel'))]",
      "sku": {
        "name": "Standard",
        "capacity": 20
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('openAiModel')]",
          "version": "[parameters('openAiModelVersion')]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai)]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts",
      "apiVersion": "2024-11-15",
      "name": "[variables('names').cosmos]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]",
      "kind": "GlobalDocumentDB",
      "properties": {
        "databaseAccountOfferType": "Standard",
        "disableLocalAuth": true,
        "enableAutomaticFailover": false,
        "capabilities": [
          {
            "name": "EnableServerless"
          }
        ],
        "consistencyPolicy": {
          "defaultConsistencyLevel": "Session"
        },
        "locations": [
          {
            "locationName": "[parameters('location')]",
            "failoverPriority": 0
          }
        ]
      }
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlDatabases",
      "apiVersion": "2024-11-15",
      "name": "[format('{0}/{1}', variables('names').cosmos, 'oes')]",
      "properties": {
        "resource": {
          "id": "oes"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos)]"
      ]
    },
    {
      "type": "Microsoft.DocumentDB/databaseAccounts/sqlRoleAssignments",
      "apiVersion": "2024-11-15",
      "name": "[format('{0}/{1}', variables('names').cosmos, guid(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos), resourceId('Microsoft.Web/sites', variables('names').app), 'data-contributor'))]",
      "properties": {
        "roleDefinitionId": "[format('{0}/sqlRoleDefinitions/00000000-0000-0000-0000-000000000002', resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos))]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('names').app), '2024-04-01', 'full').identity.principalId]",
        "scope": "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos)]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('names').app)]",
        "[resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos)]"
      ]
    },
    {
      "type": "Microsoft.Maps/accounts",
      "apiVersion": "2023-06-01",
      "name": "[variables('names').maps]",
      "location": "global",
      "tags": "[parameters('tags')]",
      "sku": {
        "name": "G2"
      },
      "kind": "Gen2",
      "properties": {
        "disableLocalAuth": true
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai)]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai), resourceId('Microsoft.Web/sites', variables('names').app), variables('roles').openAiUser)]",
      "properties": {
        "roleDefinitionId": "[variables('roles').openAiUser]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('names').app), '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('names').app)]",
        "[resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai)]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Maps/accounts', variables('names').maps)]",
      "name": "[guid(resourceId('Microsoft.Maps/accounts', variables('names').maps), resourceId('Microsoft.Web/sites', variables('names').app), variables('roles').mapsDataReader)]",
      "properties": {
        "roleDefinitionId": "[variables('roles').mapsDataReader]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('names').app), '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('names').app)]",
        "[resourceId('Microsoft.Maps/accounts', variables('names').maps)]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/components', variables('names').appInsights)]",
      "name": "[guid(resourceId('Microsoft.Insights/components', variables('names').appInsights), resourceId('Microsoft.Web/sites', variables('names').app), variables('roles').metricsPublisher)]",
      "properties": {
        "roleDefinitionId": "[variables('roles').metricsPublisher]",
        "principalId": "[reference(resourceId('Microsoft.Web/sites', variables('names').app), '2024-04-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', variables('names').app)]",
        "[resourceId('Microsoft.Insights/components', variables('names').appInsights)]"
      ]
    }
  ],
  "outputs": {
    "appName": {
      "type": "string",
      "value": "[variables('names').app]"
    },
    "appHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', variables('names').app), '2024-04-01').defaultHostName]"
    },
    "openAiEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', variables('names').openai), '2024-10-01').endpoint]"
    },
    "cosmosEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.DocumentDB/databaseAccounts', variables('names').cosmos), '2024-11-15').documentEndpoint]"
    },
    "mapsClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Maps/accounts', variables('names').maps), '2023-06-01').uniqueId]"
    }
  }
}