# Web env — endpoints only, NO secrets/keys.
# Azure Maps auth uses Entra ID tokens issued to the app's managed identity,
# obtained server-side by the agent service — never a shared map key here.
VITE_API_BASE=http://localhost:8000

# Azure Maps account clientId (the Maps resource's client_id / unique id).
# This is NOT a secret — it identifies which Maps account to authenticate the
# Entra token against. Populated from infra output after F3 is deployed.
VITE_AZURE_MAPS_CLIENT_ID=
