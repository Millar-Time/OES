# Production build config for the hosted SWA. Endpoints/identifiers only — NO
# secrets. Overrides .env at build time (`npm run build`, mode=production).

# Hosted FastAPI agent service (App Service, Central US). All /api/* calls and
# the Azure Maps token request route here so the hosted map + data are live.
VITE_API_BASE=https://oes-demo-api.azurewebsites.net

# Azure Maps account clientId (x-ms-client-id header). NOT a secret.
VITE_AZURE_MAPS_CLIENT_ID=cac64884-5403-432e-8ebe-d3e7671d0a20

# Entra ID sign-in (MSAL SPA) — public identifiers, NOT secrets.
VITE_ENTRA_TENANT_ID=6be1cdfe-875c-40fa-8c00-61b7ba1c18f9
VITE_ENTRA_CLIENT_ID=ee7a74c4-0f37-4dd3-9b68-f8a13d0d3d1d
VITE_JC_DEMO_GROUP_ID=db2a325e-ac3f-45fb-ae13-be1a0746c667
