{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "routes": [
    { "route": "/api/incident", "rewrite": "/data/incident.json" },
    { "route": "/api/resources", "rewrite": "/data/resources.json" },
    { "route": "/api/weather", "rewrite": "/data/weather.json" },
    { "route": "/api/recommendation/initial", "rewrite": "/data/recommendation-initial.json" },
    { "route": "/api/orders", "rewrite": "/data/orders.json" },
    { "route": "/api/maps/token", "statusCode": 503 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/data/*", "/assets/*", "*.{css,js,png,svg,ico}"]
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
