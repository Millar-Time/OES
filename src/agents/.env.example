# Agent service env — endpoints only, NO secrets/keys/connection strings.
# All Azure auth uses DefaultAzureCredential (managed identity in Azure,
# your developer identity locally via `az login`).
OES_ENVIRONMENT=local
OES_AZURE_OPENAI_ENDPOINT=https://<your-aoai>.openai.azure.com/
OES_AZURE_OPENAI_DEPLOYMENT=gpt-4o
OES_COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
OES_COSMOS_DATABASE=oes
OES_AZURE_MAPS_CLIENT_ID=<managed-identity-client-id>
